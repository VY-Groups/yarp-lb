{
  "Kestrel": {
    "Endpoints": {
      "AgentHttps": {
        "Url": "https://10.0.0.11:8443",
        "Certificate": {
          "Subject": "gw01.internal.example.com",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "Agent": {
    "TrustedClientThumbprints": [],
    "AllowedServices": [
      "SpeedSignYarp"
    ],
    "EnableServiceActions": false,
    "EnableConfigChanges": false,
    "GatewayConfigPath": "C:\\Services\\SpeedSignYarp\\appsettings.json",
    "StageDirectory": "C:\\ProgramData\\SpeedSignYarp\\AgentStaging",
    "TrustedSigningPublicKeyPaths": [
      "C:\\ProgramData\\SpeedSignYarp\\Agent\\controller-signing-public-current.pem",
      "C:\\ProgramData\\SpeedSignYarp\\Agent\\controller-signing-public-next.pem"
    ]
  }
}