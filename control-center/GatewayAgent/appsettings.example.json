{
  "Kestrel": {
    "Endpoints": {
      "AgentHttps": {
        "Url": "https://127.0.0.1:8443",
        "Certificate": {
          "Subject": "gw01.internal.example.com",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "Agent": {
    "TrustedClientThumbprints": [],
    "AllowedServices": [
      "GatewayCoreYarp"
    ],
    "EnableServiceActions": false,
    "EnableConfigChanges": false,
    "GatewayConfigPath": "C:\\Services\\GatewayCoreYarp\\appsettings.json",
    "StageDirectory": "C:\\ProgramData\\GatewayCoreYarp\\AgentStaging",
    "TrustedSigningPublicKeyPaths": [
      "C:\\ProgramData\\GatewayCoreYarp\\Agent\\controller-signing-public-current.pem",
      "C:\\ProgramData\\GatewayCoreYarp\\Agent\\controller-signing-public-next.pem"
    ],
    "EnableEngineConfigChanges": false,
    "AllowEngineNonLoopbackListeners": false,
    "EngineConfigPaths": {
      "l4": "C:\\Services\\YarpL4\\l4.json",
      "gslb": "C:\\Services\\YarpDns\\zones.json"
    }
  }
}
