<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GatewayCoreCommercial)' == 'true'">
    <DefineConstants>$(DefineConstants);GATEWAYCORE_COMMERCIAL</DefineConstants>
    <WarningsAsErrors>$(WarningsAsErrors);ASP0016</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(GatewayCoreCommercial)' == 'true'">
    <ProjectReference Include="../src/GatewayCore.Licensing/GatewayCore.Licensing.csproj" />
    <EmbeddedResource Include="$(GatewayCoreTrustFile)" LogicalName="GatewayCore.CommercialTrust" Condition="'$(GatewayCoreTrustFile)' != ''" />
  </ItemGroup>
  <Target Name="RequireCommercialTrust" BeforeTargets="PrepareForBuild" Condition="'$(GatewayCoreCommercial)' == 'true'">
    <Error Condition="'$(GatewayCoreTrustFile)' == '' Or !Exists('$(GatewayCoreTrustFile)')" Text="Commercial build requires an owner-pinned public trust file." />
  </Target>
  <PropertyGroup Condition="'$(GatewayCoreReleasePackage)' == 'true'">
    <DefineConstants>$(DefineConstants);GATEWAYCORE_RELEASE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GatewayCoreReleasePackage)' == 'true'">
    <EmbeddedResource Include="$(GatewayCoreReleaseTrustFile)" LogicalName="GatewayCore.ReleaseTrust" Condition="'$(GatewayCoreReleaseTrustFile)' != ''" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GatewayCoreReleaseSourceCommit</_Parameter1>
      <_Parameter2>$(GatewayCoreReleaseSourceCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="RequireReleasePackageTrust" BeforeTargets="PrepareForBuild" Condition="'$(GatewayCoreReleasePackage)' == 'true'">
    <Error Condition="'$(GatewayCoreCommercial)' != 'true'" Text="Release package profile requires commercial licensing." />
    <Error Condition="'$(GatewayCoreReleaseTrustFile)' == '' Or !Exists('$(GatewayCoreReleaseTrustFile)')" Text="Release package requires independently pinned release public trust." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(GatewayCoreReleaseSourceCommit)', '^[0-9a-f]{40}
    <Compile Include="../engines/GslbHealthContracts/PrivateKeyFileSecurity.cs" Link="PrivateKeyFileSecurity.cs" />
    <Compile Include="../engines/GslbHealthContracts/StrictJsonPropertyNames.cs" Link="StrictJsonPropertyNames.cs" />
    <Compile Include="../src/TrafficPolicies/BoundedTransportFailureHealthPolicy.cs" Link="BoundedTransportFailureHealthPolicy.cs" />
    <Compile Include="../src/TrafficPolicies/EjectionBudget.cs" Link="EjectionBudget.cs" />
    <Compile Include="../src/TrafficPolicies/PrimaryBackupCore.cs" Link="PrimaryBackupCore.cs" />
    <Compile Include="../src/TrafficPolicies/PrimaryBackupPolicy.cs" Link="PrimaryBackupPolicy.cs" />
    <Compile Include="../src/TrafficPolicies/RiseFallCounter.cs" Link="RiseFallCounter.cs" />
    <Compile Include="../src/TrafficPolicies/RiseFallActiveHealthPolicy.cs" Link="RiseFallActiveHealthPolicy.cs" />
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.32" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
</Project>
)) != 'true'" Text="Release package requires an exact lowercase source commit." />
  </Target>
  <Target Name="RequireReleasePackageOnCommercialPublish" BeforeTargets="Publish" Condition="'$(GatewayCoreCommercial)' == 'true' And '$(GatewayCoreReleasePackage)' != 'true'">
    <Error Text="Commercial publishing requires the signed release package profile." />
  </Target>
  <ItemGroup>
    <Compile Remove="GatewayAgent/**/*.cs;tests/**/*.cs;tools/**/*.cs" />
    <Compile Include="../engines/GslbHealthContracts/PrivateKeyFileSecurity.cs" Link="PrivateKeyFileSecurity.cs" />
    <Compile Include="../engines/GslbHealthContracts/StrictJsonPropertyNames.cs" Link="StrictJsonPropertyNames.cs" />
    <Compile Include="../src/TrafficPolicies/BoundedTransportFailureHealthPolicy.cs" Link="BoundedTransportFailureHealthPolicy.cs" />
    <Compile Include="../src/TrafficPolicies/EjectionBudget.cs" Link="EjectionBudget.cs" />
    <Compile Include="../src/TrafficPolicies/PrimaryBackupCore.cs" Link="PrimaryBackupCore.cs" />
    <Compile Include="../src/TrafficPolicies/PrimaryBackupPolicy.cs" Link="PrimaryBackupPolicy.cs" />
    <Compile Include="../src/TrafficPolicies/RiseFallCounter.cs" Link="RiseFallCounter.cs" />
    <Compile Include="../src/TrafficPolicies/RiseFallActiveHealthPolicy.cs" Link="RiseFallActiveHealthPolicy.cs" />
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.32" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
</Project>
