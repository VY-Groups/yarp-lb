{
  "DevelopmentLab": {
    "ManagedBy": "dev/laptop/Start-Laptop.ps1",
    "LabOnly": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "LocalHttp": {
        "Url": "http://127.0.0.1:8080"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "laptop-demo": {
        "ClusterId": "laptop-demo",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "laptop-demo": {
        "LoadBalancingPolicy": "WeightedRandom",
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:01",
            "Timeout": "00:00:01",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "1"
        },
        "Destinations": {
          "A": {
            "Address": "http://127.0.0.1:18081/",
            "Metadata": { "Weight": "70", "TrafficState": "active", "SlowStartSeconds": "0" }
          },
          "B": {
            "Address": "http://127.0.0.1:18082/",
            "Metadata": { "Weight": "30", "TrafficState": "active", "SlowStartSeconds": "0" }
          }
        }
      }
    }
  }
}
