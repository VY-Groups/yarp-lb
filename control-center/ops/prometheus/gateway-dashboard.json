{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Gateway process request rate. Select a bounded job and region in the dashboard variables.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (instance) (rate(yarp_control_http_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "HTTP requests per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "5xx response rate from the gateway's own request counters.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (instance) (rate(yarp_control_http_responses_total{job=~\"$job\",status_class=\"5xx\"}[5m]))", "legendFormat": "{{instance}} 5xx/s", "refId": "A"}],
      "title": "HTTP 5xx responses per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Gateway-observed histogram. For customer availability SLI, use independent external HTTPS probes below.",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (instance,le) (rate(yarp_control_http_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{instance}} p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (instance,le) (rate(yarp_control_http_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{instance}} p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (instance,le) (rate(yarp_control_http_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{instance}} p99", "refId": "C"}
      ],
      "title": "Gateway request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Independent external HTTP readiness probes are required. Missing samples are not counted as healthy. Annual result is shown only after sufficient coverage.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "avg_over_time(gatewaycore:availability_probe_success:sample{job=~\"$job\"}[24h])", "legendFormat": "{{service}} {{region}} 24h", "refId": "A"},
        {"expr": "(count_over_time(gatewaycore:availability_probe_success:sample{job=~\"$job\"}[365d]) >= 3090528) * on(instance,service,region) group_left avg_over_time(gatewaycore:availability_probe_success:sample{job=~\"$job\"}[365d])", "legendFormat": "{{service}} {{region}} rolling year (coverage-gated)", "refId": "B"}
      ],
      "title": "External availability SLI (not a CI test score)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Active health is 1 healthy, 0 unknown and -1 unhealthy. Destination labels come only from configured clusters.",
      "fieldConfig": {"defaults": {"min": -1, "max": 1, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "yarp_control_destination_active_health{job=~\"$job\"}", "legendFormat": "{{instance}} {{destination}}", "refId": "A"}],
      "title": "Backend health by configured destination",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Live in-flight request gauges for configured destinations.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "yarp_control_destination_inflight_requests{job=~\"$job\"}", "legendFormat": "{{instance}} {{destination}}", "refId": "A"}],
      "title": "In-flight requests by backend",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Any increase indicates log messages were lost or the log writer failed.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "increase(yarp_logging_dropped_total{job=~\"$job\"}[5m])", "legendFormat": "{{instance}} dropped", "refId": "A"},
        {"expr": "increase(yarp_logging_dropped_low_priority_total{job=~\"$job\"}[5m])", "legendFormat": "{{instance}} low priority dropped", "refId": "B"},
        {"expr": "increase(yarp_logging_dropped_high_priority_total{job=~\"$job\"}[5m])", "legendFormat": "{{instance}} high priority dropped", "refId": "C"},
        {"expr": "increase(yarp_logging_write_errors_total{job=~\"$job\"}[5m])", "legendFormat": "{{instance}} writer errors", "refId": "D"}
      ],
      "title": "Logging pipeline loss and errors (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Process resource indicators; investigate sustained growth alongside request volume and errors.",
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "yarp_control_process_working_set_bytes{job=~\"$job\"}", "legendFormat": "{{instance}} working set", "refId": "A"},
        {"expr": "yarp_control_gc_heap_bytes{job=~\"$job\"}", "legendFormat": "{{instance}} managed heap", "refId": "B"}
      ],
      "title": "Gateway process memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "OTLP-exported proxy throughput and fixed response classes. Series appear when OTLP is configured and a Collector is accepting metrics.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "id": 9,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (http_response_status_class) (rate(gateway_proxy_requests_total[5m]))", "legendFormat": "{{http_response_status_class}}", "refId": "A"}
      ],
      "title": "OTLP proxy request rate by status class",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "OTLP proxy duration histogram, derived from the bounded latency metric.",
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_proxy_request_duration_milliseconds_bucket[5m])))", "legendFormat": "OTLP p95", "refId": "A"}
      ],
      "title": "OTLP proxy p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Process-local per-destination capacity. Limits are not shared between gateway nodes.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "yarp_control_destination_admission_inflight_requests{job=~\"$job\"}", "legendFormat": "{{instance}} {{destination}} in-flight", "refId": "A"},
        {"expr": "yarp_control_destination_admission_queued_requests{job=~\"$job\"}", "legendFormat": "{{instance}} {{destination}} queued", "refId": "B"}
      ],
      "title": "Per-destination in-flight and queued requests",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Local capacity rejections and queue timeouts, separate from upstream HTTP response classes.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (instance,destination) (rate(yarp_control_destination_admission_rejected_total{job=~\"$job\"}[5m]))", "legendFormat": "{{instance}} {{destination}} rejected", "refId": "A"},
        {"expr": "sum by (instance,destination) (rate(yarp_control_destination_admission_queue_timeouts_total{job=~\"$job\"}[5m]))", "legendFormat": "{{instance}} {{destination}} timed out", "refId": "B"}
      ],
      "title": "Per-destination admission failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Average wait among queued requests; zero until requests have waited for a slot.",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (instance,destination) (rate(yarp_control_destination_admission_queue_wait_seconds_sum{job=~\"$job\"}[5m])) / clamp_min(sum by (instance,destination) (rate(yarp_control_destination_admission_queue_wait_seconds_count{job=~\"$job\"}[5m])), 1e-9)", "legendFormat": "{{instance}} {{destination}} average queue wait", "refId": "A"}],
      "title": "Per-destination queue wait",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Aggregate requests without per-destination counters after the process reaches its fixed destination telemetry limit. This series intentionally has no destination label.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "id": 14,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "yarp_control_destination_telemetry_untracked_requests_total{job=~\"$job\"}", "legendFormat": "{{instance}} untracked destination requests", "refId": "A"}],
      "title": "Destination telemetry cardinality overflow",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Approximate unavailable seconds across the last hour, computed as failed samples times the documented 10-second probe cadence. It is a sampled user-visible interruption measure; short gaps may be undercounted and this does not identify the failover mechanism.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "id": 15,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (service,region) (sum_over_time((probe_success{job=\"gatewaycore-availability\"} == bool 0)[1h:10s])) * 10", "legendFormat": "{{service}} {{region}} unavailable seconds / 1h", "refId": "A"}
      ],
      "title": "Observed external interruption time (rolling 1h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"},
      "description": "Opt-in durable external audit outbox status. 1 is configured or faulted, -1 pending means unreadable. Disabled or missing telemetry does not establish remote audit receipt delivery. Requires PR #452 metrics and the independent receiver.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "id": 16,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "gateway_audit_outbox_enabled{job=\"otel-collector\"}", "legendFormat": "{{service_instance_id}} enabled", "refId": "A"},
        {"expr": "gateway_audit_outbox_pending{job=\"otel-collector\"}", "legendFormat": "{{service_instance_id}} pending", "refId": "B"},
        {"expr": "gateway_audit_outbox_storage_fault{job=\"otel-collector\"}", "legendFormat": "{{service_instance_id}} storage fault", "refId": "C"},
        {"expr": "gateway_audit_outbox_delivery_blocked{job=\"otel-collector\"}", "legendFormat": "{{service_instance_id}} delivery blocked", "refId": "D"}
      ],
      "title": "Durable external audit outbox (opt-in)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["gatewaycore", "load-balancer", "operations"],
  "templating": {"list": [{"current": {}, "datasource": {"type": "prometheus", "uid": "gatewaycore-prometheus"}, "definition": "label_values(up, job)", "includeAll": true, "multi": true, "name": "job", "options": [], "query": {"query": "label_values(up, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "refresh": 2, "type": "query"}]},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "GatewayCore HTTP and Availability",
  "uid": "gatewaycore-http-availability",
  "version": 2
}
