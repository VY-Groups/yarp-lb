[Unit]
Description=SpeedSign YARP single-tenant on-prem v1 gateway (two-node test profile)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=speedsg-gateway
Group=speedsg-gateway
WorkingDirectory=/opt/speedsign-yarp/current
ExecStart=/usr/bin/dotnet /opt/speedsign-yarp/current/SpeedSignYarp.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=YARP_CONTROL_PLANE_DIR=/var/lib/speedsign-yarp/control-plane
Environment=YARP_RUNTIME_CONFIG_PATH=/var/lib/speedsign-yarp/control-plane/config/appsettings.json
Environment=YARP_LINUX_DP_CERT_PFX_PATH=/etc/speedsign-yarp/secrets/dp-protection.pfx
Environment=YARP_LINUX_DP_CERT_PASSWORD_FILE=/etc/speedsign-yarp/secrets/dp-pfx-password
Environment=YARP_LISTENERS_CONFIG_FILE=/etc/speedsign-yarp/listeners.json
# Exact measured LimitNOFILE is REQUIRED in an approved drop-in:
# /etc/systemd/system/speedsign-yarp.service.d/limits.conf
# Must be >= 2.5*Kestrel.MaxConcurrentConnections + 4096.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/speedsign-yarp /var/log/speedsign-yarp
# A validated listener JSON binds traffic only on the explicit data IP:
# HTTP 80 and ECDSA HTTPS 443; admin/metrics on explicit management IP only.
# No NAT/port-forwarding for 443 is assumed or required.

[Install]
WantedBy=multi-user.target
