# Disposable CI container, not a production deployment image.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish control-center/GatewayCoreYarp.csproj -c Release -o /published

FROM mcr.microsoft.com/dotnet/aspnet:10.0
USER root
# The lab image still requires real openssl, CA certificates and curl.
# Rotate HTTPS Ubuntu archive endpoints on transport/index failures; retain
# every configured pocket and the upstream Signed-By keyring.
RUN set -eu; \
    sources=/etc/apt/sources.list.d/ubuntu.sources; \
    test -f "$sources"; \
    cp "$sources" /tmp/gatewaycore-ubuntu.sources; \
    for mirror in primary us.archive.ubuntu.com mirrors.edge.kernel.org; do \
        cp /tmp/gatewaycore-ubuntu.sources "$sources"; \
        if [ "$mirror" = primary ]; then \
            sed -i 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' "$sources"; \
        else \
            sed -i -E "s|https?://(archive|security)\\.ubuntu\\.com/ubuntu|https://$mirror/ubuntu|g" "$sources"; \
        fi; \
        rm -rf /var/lib/apt/lists/*; \
        echo "GatewayCore lab dependency mirror: $mirror"; \
        if timeout 180s apt-get -o Acquire::Retries=1 -o Acquire::https::Timeout=15 -o APT::Update::Error-Mode=any update \
            && timeout 180s apt-get -o Acquire::Retries=1 -o Acquire::https::Timeout=15 install -y --download-only --no-install-recommends openssl ca-certificates curl; then \
            apt-get install -y --no-download --no-install-recommends openssl ca-certificates curl; \
            break; \
        fi; \
        test "$mirror" != mirrors.edge.kernel.org || exit 1; \
        sleep 5; \
    done; \
    cp /tmp/gatewaycore-ubuntu.sources "$sources"; \
    rm /tmp/gatewaycore-ubuntu.sources; \
    rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --home-dir /state --create-home --shell /usr/sbin/nologin yarpci \
 && mkdir -p /app /state && chown -R yarpci:yarpci /state
WORKDIR /app
COPY --from=build /published/ /app/
COPY tests/CI/stack/entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh
USER 10001
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://0.0.0.0:8080 \
    YARP_CONTROL_PLANE_DIR=/state \
    YARP_RUNTIME_CONFIG_PATH=/state/config/appsettings.json \
    YARP_LINUX_DP_CERT_PFX_PATH=/state/secrets/current.pfx \
    YARP_LINUX_DP_CERT_PASSWORD_FILE=/state/secrets/pfx-password
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
